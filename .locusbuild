{
  "region": "us-east-1",
  "services": {
    "studio": {
      "path": ".",
      "port": 3000,
      "startCommand": "pnpm start",
      "runtime": {
        "cpu": 512,
        "memory": 1024
      },
      "env": {
        "LOCUS_API_KEY": "${{LOCUS_API_KEY}}",
        "LOCUS_WEBHOOK_SECRET": "${{LOCUS_WEBHOOK_SECRET}}",
        "NEXT_PUBLIC_APP_URL": "${{NEXT_PUBLIC_APP_URL}}"
      }
    }
  }
}